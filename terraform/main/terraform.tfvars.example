# Copy to terraform.tfvars (git-ignored) and fill in real values:
#   cp terraform.tfvars.example terraform.tfvars

# Receives DLQ alarm emails. Confirm the subscription email AWS sends after apply.
alert_email = "you@example.com"

# Browser origins allowed to upload via presigned URLs (default shown).
# allowed_origins = ["http://localhost:5173"]

# Who may reach the ALB on port 80. Required; 0.0.0.0/0 is rejected until the
# API has authentication.
allowed_cidrs = ["203.0.113.7/32"]
